@namespace("ru.yandex.practicum.kafka.telemetry.event")
protocol HubEventProtocolAvro {
	enum DeviceType {
		MOTION_SENSOR,
		TEMPERATURE_SENSOR,
		LIGHT_SENSOR,
		CLIMATE_SENSOR,
		SWITCH_SENSOR
	}

	enum TypeConditionAvro {
		MOTION,
		LUMINOSITY,
		SWITCH,
		TEMPERATURE,
		CO2LEVEL,
		HUMIDITY
	}

	enum OperationAvro {
		EQUALS,
		GREATER_THAN,
		LOWER_THAN
	}

	enum ActionAvro {
		ACTIVATE,
		DEACTIVATE,
		INVERSE,
		SET_VALUE
	}

	record DeviceAddedEventAvro {
		string id;
		DeviceType deviceType;
	}

	record DeviceRemovedEventAvro {
		string id;
	}

	record ScenarioConditionAvro {
		string sensorId;
		TypeConditionAvro type;
		OperationAvro operation;
		int value;
	}

	record DeviceActionAvro {
		string sensorId;
		ActionAvro type;
		int? value;
	}

	record ScenarioAddedEventAvro {
		string name;
		array<ScenarioConditionAvro> conditions;
		array<DeviceActionAvro> actions;
	}

	record ScenarioRemovedEventAvro {
		string name;
	}

	record HubEventAvro {
		string hubId;
		timestamp_ms timestamp;
		union{
			DeviceAddedEventAvro,
			DeviceRemovedEventAvro,
			ScenarioAddedEventAvro,
			ScenarioRemovedEventAvro} payload;
	}
}