@namespace("ru.yandex.practicum.kafka.telemetry.event")
protocol HubEventProtocol {
	enum DeviceType {
		MOTION_SENSOR,
		TEMPERATURE_SENSOR,
		LIGHT_SENSOR,
		CLIMATE_SENSOR,
		SWITCH_SENSOR
	}

	enum TypeCondition {
		MOTION,
		LUMINOSITY,
		SWITCH,
		TEMPERATURE,
		CO2LEVEL,
		HUMIDITY
	}

	enum Operation {
		EQUALS,
		GREATER_THAN,
		LOWER_THAN
	}

	enum Action {
		ACTIVATE,
		DEACTIVATE,
		INVERSE,
		SET_VALUE
	}

	record DeviceAddedEvent {
		string id;
		DeviceType deviceType;
	}

	record DeviceRemovedEvent {
		string id;
	}

	record ScenarioCondition {
		string sensorId;
		TypeCondition type;
		Operation operation;
		int value;
	}

	record DeviceAction {
		string sensorId;
		Action type;
		int value;
	}

	record ScenarioAddedEvent {
		string name;
		array<ScenarioCondition> conditions;
		array<DeviceAction> actions;
	}

	record ScenarioRemovedEvent {
		string name;
	}

	record HubEvent {
		string hubId;
		timestamp_ms timestamp;
		union{DeviceAddedEvent, DeviceRemovedEvent, ScenarioAddedEvent, ScenarioRemovedEvent} payload;
	}
}